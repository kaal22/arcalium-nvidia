[Desktop Entry]
Type=Application
Version=1.0
Name=Arcalium Control Centre
GenericName=System Control Centre
Comment=Hardware status, gaming setup and Arcalium diagnostics (first launch opens Setup)
Exec=env __NV_DISABLE_EXPLICIT_SYNC=1 arcalium-control-centre-launch
Icon=io.arcalium.ControlCentre
Terminal=false
Categories=Settings;System;X-Arcalium;
Keywords=arcalium;gpu;nvidia;steam;diagnostics;setup;
StartupNotify=true
StartupWMClass=arcalium-control-centre
X-GNOME-UsesNotifications=false
