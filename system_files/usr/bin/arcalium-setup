#!/usr/bin/bash
# Launch the Arcalium first-run setup wizard (Control Centre --setup).
# Skips the live installer environment. Always launches when invoked from the
# application menu (Resume / Restart); autostart uses --autostart so completed
# users and users who disabled "Show on startup" are left alone.
#
# Plasma Welcome / Wi‑Fi runs before login on this image. Autostart therefore
# opens promptly after the user session is up. If Welcome/Portal is still
# running in this session (rare), wait for it to exit first.
set -euo pipefail

AUTOSTART=0
for arg in "$@"; do
  if [[ "${arg}" == "--autostart" ]]; then
    AUTOSTART=1
  fi
done

if grep -Eq '(^|[[:space:]])(rd\.live|boot=live|liveimg|rd\.live\.image)(=|[[:space:]]|$)' /proc/cmdline 2>/dev/null; then
  exit 0
fi
if [[ "${USER:-}" == "liveuser" || "${USER:-}" == "anaconda" ]]; then
  exit 0
fi
if [[ -d /run/anaconda || -f /etc/anaconda-release ]]; then
  exit 0
fi

CONFIG_DIR="${HOME}/.config/arcalium"
COMPLETE="${CONFIG_DIR}/setup-complete.json"
PREFS="${CONFIG_DIR}/setup-prefs.json"

# Drop Bazzite's silent Steam autostart when no Steam client is present (skel
# copy may already exist on upgraded accounts).
if [[ ! -x /usr/bin/steam ]]; then
  rm -f "${HOME}/.config/autostart/steam.desktop"
fi

# Match Plasma Welcome, Bazzite Portal / yafti, and common binary names.
desktop_first_run_running() {
  pgrep -f \
    'plasma-welcome|org\.kde\.plasma-welcome|/usr/bin/plasma-welcome|yafti|yafti-gtk|bazzite-portal|bazzite-welcome' \
    >/dev/null 2>&1
}

if [[ "${AUTOSTART}" -eq 1 ]]; then
  if [[ -f "${COMPLETE}" ]] \
    && grep -q '"completed"[[:space:]]*:[[:space:]]*true' "${COMPLETE}" 2>/dev/null; then
    exit 0
  fi
  if [[ -f "${PREFS}" ]] \
    && grep -Eq '"showOnStartup"[[:space:]]*:[[:space:]]*false' "${PREFS}" 2>/dev/null; then
    exit 0
  fi

  # Wait briefly for a graphical session to exist.
  for _ in $(seq 1 60); do
    if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
      break
    fi
    sleep 1
  done

  # Short settle so the desktop and any leftover first-run UI can start.
  # Do not wait minutes for Welcome to appear — it runs before login.
  sleep 3

  # If Welcome/Portal is still running in this login session, wait for it.
  # Cap at 45 minutes so a hung Welcome cannot block Setup forever.
  if desktop_first_run_running; then
    run_deadline=$((SECONDS + 2700))
    while (( SECONDS < run_deadline )); do
      if desktop_first_run_running; then
        sleep 2
        continue
      fi
      sleep 2
      if desktop_first_run_running; then
        continue
      fi
      break
    done
  fi
fi

export __NV_DISABLE_EXPLICIT_SYNC="${__NV_DISABLE_EXPLICIT_SYNC:-1}"
exec arcalium-control-centre --setup
