#!/usr/bin/python3
"""Arcalium OS CLI — Phase 2 hardware diagnostics entrypoint.

See docs/PHASE2_VALIDATION.md and PRODUCT_SPEC §10.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Library lives beside us under /usr/lib/arcalium/ctl
_LIB = Path("/usr/lib/arcalium")
if _LIB.is_dir() and str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))

from ctl.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
