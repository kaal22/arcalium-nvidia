#!/usr/bin/bash
# Launch Heroic Games Launcher, provisioning GE-Proton on first run so beginners
# never need Settings → Wine Manager.
set -euo pipefail

HEROIC_ID="com.heroicgameslauncher.hgl"
TOOLS="${HOME}/.var/app/${HEROIC_ID}/config/heroic/tools/proton"

_has_ge_proton() {
  local d
  [[ -d "${TOOLS}" ]] || return 1
  shopt -s nullglob
  for d in "${TOOLS}"/GE-Proton* "${TOOLS}"/Proton-GE*; do
    [[ -f "${d}/proton" ]] && return 0
  done
  return 1
}

_notify() {
  local title="$1"
  local body="$2"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "${title}" --msgbox "${body}" || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "${title}" "${body}" || true
  else
    printf '%s: %s\n' "${title}" "${body}" >&2
  fi
}

_close_progress() {
  local ref="${1:-}"
  [[ -n "${ref}" ]] || return 0
  # kdialog --progressbar prints: service objectPath
  # shellcheck disable=SC2086
  qdbus ${ref} close >/dev/null 2>&1 || true
}

if ! _has_ge_proton; then
  _notify "Arcalium" \
    "Setting up Heroic game compatibility.

This is a one-time download of about 400 MB and may take a few minutes. Heroic will open when it finishes."

  progress_ref=""
  if command -v kdialog >/dev/null 2>&1; then
    progress_ref="$(kdialog --title "Arcalium" --progressbar "Downloading GE-Proton…" 0 2>/dev/null)" || progress_ref=""
  fi

  set +e
  out="$(arcaliumctl proton install-recommended --json 2>&1)"
  rc=$?
  set -e

  _close_progress "${progress_ref}"

  if [[ "${rc}" -ne 0 ]]; then
    detail="$(printf '%s' "${out}" | tr '\n' ' ' | cut -c1-400)"
    _notify "Arcalium" \
      "Could not download game compatibility tools automatically.

${detail}

You can still open Heroic and use Settings → Wine Manager to install GE-Proton."
  fi
fi

exec flatpak run "${HEROIC_ID}" "$@"
