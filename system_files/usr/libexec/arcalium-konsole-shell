#!/usr/bin/bash
# Konsole entrypoint: always show Arcalium MOTD, then an interactive bash.
# Avoids depending on LoginShell / profile.d / ~/.bashrc sourcing quirks.
set -euo pipefail

if [[ ! -e "${HOME:-}/.config/no-show-user-motd" ]] && [[ -x /usr/libexec/arcalium-motd ]]; then
  /usr/libexec/arcalium-motd || true
fi

export ARCALIUM_MOTD_DONE=1
export USERMOTDSOURCED=Y

exec /bin/bash "$@"
