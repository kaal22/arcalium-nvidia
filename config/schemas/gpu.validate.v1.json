{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcalium.local/schemas/gpu.validate.v1.json",
  "title": "arcalium.gpu.validate/v1",
  "type": "object",
  "required": ["schema", "overall", "checks", "errorCodes"],
  "properties": {
    "schema": { "const": "arcalium.gpu.validate/v1" },
    "overall": {
      "type": "string",
      "enum": ["ready", "warning", "unsupported", "unknown"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ready", "warning", "unsupported", "unknown"]
          },
          "detail": { "type": ["string", "null"] },
          "code": { "type": ["string", "null"] }
        }
      }
    },
    "errorCodes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gpu": { "type": "object" }
  },
  "additionalProperties": true
}
