    "prettyName": { "type": ["string", "null"] },
    "osId": { "type": ["string", "null"] },
    "hostname": { "type": "string" },
    "kernel": { "type": "string" },
    "cpuModel": { "type": ["string", "null"] },
    "memoryBytes": { "type": ["integer", "null"] },
    "memoryGiB": { "type": ["number", "null"] },
    "sessionType": { "type": "string" },
