# Arcalium OS NVIDIA Edition — image build parameters
# Keep IMAGE_NAME in sync with disk_config/iso.toml and .github/workflows/build-disk.yml

IMAGE_NAME=arcalium-os-nvidia

# GitHub username or organisation that owns the repository / GHCR package
REPO_ORGANIZATION="kaal22"

IMAGE_DESC="Arcalium OS NVIDIA Edition — gaming-first Linux OS built on Bazzite"
IMAGE_KEYWORDS="gaming,linux,bazzite,nvidia,bootc,kde,proton,arcalium"

# Replace with Arcalium branding URL when available
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"

# Channels: dev (active development) → testing → stable
DEFAULT_TAG="dev"

BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
